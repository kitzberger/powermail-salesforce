plugin.tx_powermailsalesforce {
    settings {
        #cat=PowermailSalesforce/basic/a; type=string; label=Target URL
        targetUrl = https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8

        debug {
            #cat=PowermailSalesforce/advanced/a; type=boolean; label=Enable debug mode
            enable = 0
            #cat=PowermailSalesforce/advanced/b; type=string; label=Debug target url (Sandbox)
            targetUrl = https://test.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8
            #cat=PowermailSalesforce/advanced/c; type=string; label=Debug email address
            email =
        }

        web2case {
            #cat=PowermailSalesforce/web2case/a; type=string; label=Salesforce Instance URL
            instanceUrl =
            #cat=PowermailSalesforce/web2case/b; type=string; label=OAuth2 Client ID
            clientId =
            #cat=PowermailSalesforce/web2case/c; type=string; label=OAuth2 Client Secret
            clientSecret =
            #cat=PowermailSalesforce/web2case/d; type=string; label=API Version
            apiVersion = v64.0
        }
    }
}
